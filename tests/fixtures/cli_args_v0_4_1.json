            "5d",
            "1mo",
            "3mo",
            "6mo",
            "1y",
            "2y",
            "5y",
            "10y",
            "ytd",
            "max"
          ],
          "title": "HistoryPeriod",
          "type": "string"
        }
      },
      "description": "Fetch history and validate",
      "properties": {
        "v": {
          "default": false,
          "description": "Verbose output (INFO level)",
          "title": "V",
          "type": "boolean"
        },
        "vv": {
