  "help": {
    "SearchArgs": "usage: tool [-h] [-v bool] [-vv bool] [--format FORMAT] [--schema]\n            [--symbol {SYMBOL,null}] [--isin {ISIN,null}] [--desc {NAME,null}]\n            [--exchange {EXCHANGE,null}] [--currency {CURR,null}]\n            [--country {CC,null}] [--asset_class {CLASS,null}]\n            [--date {DATE,null}] [--price {PRICE,null}] [--limit LIMIT]\n\noptions:\n  -h, --help            show this help message and exit\n  -v, --verbose bool    Verbose output (INFO level)\n  -vv, --debug bool     Debug output (DEBUG level)\n  --format FORMAT       Output format (text, json, yaml)\n  --schema              Output the JSON schema of the CLI interface\n  --symbol {SYMBOL,null}\n                        Security symbol to search for\n  --isin {ISIN,null}    ISIN code to search for\n  --desc {NAME,null}    Security name or description\n  --exchange {EXCHANGE,null}\n                        Exchange code (e.g. US, L, GY)\n  --currency {CURR,null}\n                        Currency code (e.g. USD, EUR, GBP)\n  --country {CC,null}   Two-letter country code\n  --asset_class {CLASS,null}\n                        Asset class (Equity, Commodity, etc.)\n  --date {DATE,null}    Reference date for price/validation\n  --price {PRICE,null}  Reference price for validation\n  --limit LIMIT         Maximum number of results to return\n",
    "HistoryArgs": "usage: tool [-h] [-v bool] [-vv bool] [--format FORMAT] [--schema]\n            [--symbol {SYMBOL,null}] [--isin {ISIN,null}] [--desc {NAME,null}]\n            [--exchange {EXCHANGE,null}]\n            [--period {D1,D5,MO1,MO3,MO6,Y1,Y2,Y5,Y10,YTD,MAX}]\n            [--date {DATE,null}] [--price {PRICE,null}]\n\noptions:\n  -h, --help            show this help message and exit\n  -v, --verbose bool    Verbose output (INFO level)\n  -vv, --debug bool     Debug output (DEBUG level)\n  --format FORMAT       Output format (text, json, yaml)\n  --schema              Output the JSON schema of the CLI interface\n  --symbol {SYMBOL,null}\n                        Security symbol\n  --isin {ISIN,null}    ISIN code\n  --desc {NAME,null}    Security description\n  --exchange {EXCHANGE,null}\n                        Exchange code\n  --period {D1,D5,MO1,MO3,MO6,Y1,Y2,Y5,Y10,YTD,MAX}\n                        Range of historical data (e.g. 1mo, 1y, max)\n  --date {DATE,null}    Specific date to validate price against\n  --price {PRICE,null}  Expected price for validation\n"
